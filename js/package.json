{
  "name": "@limaformat/lima",
  "version": "0.1.0",
  "description": "Lima frontmatter parser — LIMA Is Metadata Annotation",
  "keywords": ["frontmatter", "parser", "yaml", "markdown", "metadata"],
  "homepage": "https://limaformat.dev",
  "author": "Michael Kortstiege",
  "repository": {
    "type": "git",
    "url": "https://github.com/limaformat/lima",
    "directory": "js"
  },
  "bugs": "https://github.com/limaformat/lima/issues",
  "license": "ISC",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretest": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun test",
    "bench": "bun run bench/index.ts",
    "bench:vs-yaml": "bun run bench/vs-yaml.ts",
    "bench:vs-yaml:node": "node bench/vs-yaml-node.mjs",
    "bench:differential": "bun run bench/differential.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^5.2.3",
    "typescript": "^7.0.2"
  }
}
