{
  "id": "core.yaml-header.block-scalar-hash-and-continuation.strict",
  "spec": "core",
  "specVersion": "1.3",
  "section": "6.1.5",
  "description": "An indented # line is content of a | scalar, and ^^ joins the next line to it. Strict mode.",
  "input": "k: |\n  #x\n  ^^y\n",
  "options": {
    "strict": true
  },
  "expect": {
    "result": {
      "k": "#x y"
    }
  },
  "tags": [
    "yaml",
    "block-scalar",
    "strict"
  ]
}
