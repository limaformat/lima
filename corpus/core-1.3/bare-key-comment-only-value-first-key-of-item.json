{
  "id": "core.bare-key.comment-only-value-first-key-of-item",
  "spec": "core",
  "specVersion": "1.3",
  "section": "7.2",
  "description": "Core 1.3: the first key of an object item whose value is only a comment takes the block deeper than its column. Non-strict mode.",
  "input": "k:\n  - b: # c\n      c: 1\n",
  "expect": {
    "result": {
      "k": [
        {
          "b": {
            "c": 1
          }
        }
      ]
    }
  },
  "tags": [
    "bare-key",
    "comments"
  ]
}
