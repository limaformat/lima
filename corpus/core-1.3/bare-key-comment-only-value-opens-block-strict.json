{
  "id": "core.bare-key.comment-only-value-opens-block.strict",
  "spec": "core",
  "specVersion": "1.3",
  "section": "4",
  "description": "Core 1.3: an entry whose value is only a comment is a bare key; the deeper lines are its block. Strict mode.",
  "input": "k: # c\n  a: 1\n",
  "options": {
    "strict": true
  },
  "expect": {
    "result": {
      "k": {
        "a": 1
      }
    }
  },
  "tags": [
    "bare-key",
    "comments",
    "strict"
  ]
}
