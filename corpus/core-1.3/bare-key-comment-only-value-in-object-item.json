{
  "id": "core.bare-key.comment-only-value-in-object-item",
  "spec": "core",
  "specVersion": "1.3",
  "section": "7.1",
  "description": "Core 1.3: a later key of an object item whose value is only a comment takes the block deeper than its column. Non-strict mode.",
  "input": "k:\n  - a: x\n    b: #c\n      c: 1\n",
  "expect": {
    "result": {
      "k": [
        {
          "a": "x",
          "b": {
            "c": 1
          }
        }
      ]
    }
  },
  "tags": [
    "bare-key",
    "comments"
  ]
}
