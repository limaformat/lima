{
  "id": "core.keys.single-quoted-key-ends-in-backslash.strict",
  "spec": "core",
  "specVersion": "1.3",
  "section": "5.2",
  "description": "Core 1.3: a single-quoted key is literal, so in 'a\\': the second ' closes the key a\\, before a tab or a space. Strict mode.",
  "input": "'a\\':\t1\n'b\\': 2\n",
  "options": {
    "strict": true
  },
  "expect": {
    "result": {
      "a\\": 1,
      "b\\": 2
    }
  },
  "tags": [
    "keys",
    "quoting",
    "tabs",
    "strict"
  ]
}
