{
  "id": "core.yaml-header.folded.strict",
  "spec": "core",
  "specVersion": "1.3",
  "section": "6.1.6",
  "description": "Core 1.3: > is a YAML block scalar header: an error in strict mode at its own line, a string otherwise. Strict mode.",
  "input": "k: >\n",
  "options": {
    "strict": true
  },
  "expect": {
    "error": {
      "code": "UNSUPPORTED_YAML",
      "line": 1,
      "contains": "\"^^\""
    }
  },
  "tags": [
    "yaml",
    "block-scalar",
    "strict",
    "error"
  ]
}
