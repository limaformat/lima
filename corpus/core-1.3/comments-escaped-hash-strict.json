{
  "id": "core.comments.escaped-hash.strict",
  "spec": "core",
  "specVersion": "1.3",
  "section": "6.1.4",
  "description": "Core 1.3: \\# still yields #, and only the backslash right before the # escapes it. Strict mode.",
  "input": "k: \\#x\nj: \\\\#x\n",
  "options": {
    "strict": true
  },
  "expect": {
    "result": {
      "k": "#x",
      "j": "\\#x"
    }
  },
  "tags": [
    "comments",
    "strict"
  ]
}
