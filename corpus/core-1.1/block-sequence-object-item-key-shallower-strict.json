{
  "id": "core.block-sequence.object-item-key-shallower.strict",
  "spec": "core",
  "specVersion": "1.1",
  "section": "7.2",
  "description": "A line less indented than an object item's key column ends the item (§7.1 rule 4); it and the lines after it at the old key column belong to no item.",
  "input": "list:\n  - a: 1\n   c: 2\n    d: 3\n",
  "options": {
    "strict": true
  },
  "expect": {
    "error": {
      "line": 3,
      "code": "INVALID_INDENTATION"
    }
  },
  "tags": [
    "block-sequence",
    "object-item",
    "indentation",
    "error",
    "strict"
  ]
}
