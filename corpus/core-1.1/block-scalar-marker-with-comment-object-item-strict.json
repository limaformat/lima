{
  "id": "core.block-scalar.marker-with-comment-object-item.strict",
  "spec": "core",
  "specVersion": "1.1",
  "section": "6.1.5",
  "description": "`| # c` is no block scalar marker for the first or a later key of an object item either.",
  "input": "l:\n  - a: | # c\n    b: | # c\n",
  "options": {
    "strict": true
  },
  "expect": {
    "result": {
      "l": [
        {
          "a": "|",
          "b": "|"
        }
      ]
    }
  },
