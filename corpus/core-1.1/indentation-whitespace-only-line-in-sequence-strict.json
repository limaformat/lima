{
  "id": "core.indentation.whitespace-only-line-in-sequence.strict",
  "spec": "core",
  "specVersion": "1.1",
  "section": "7.1",
  "description": "A whitespace-only line inside a block sequence is an empty line (§7.1 rule 6), however many spaces it has.",
  "input": "a:\n  - x\n    \n  - y\n",
  "options": {
    "strict": true
  },
  "expect": {
    "result": {
      "a": [
        "x",
        "y"
      ]
    }
  },
  "tags": [
    "indentation",
    "whitespace",
    "strict"
  ]
}
