{
  "id": "core.block-sequence.skipped-line-under-bare-item-key",
  "spec": "core",
  "specVersion": "1.1",
  "section": "7.1",
  "description": "A skipped line at an object item's key column is no deeper than the bare key, so the key gets no block; the item goes on past it.",
  "input": "list:\n  - a:\n    freetext\n      c: 1\n",
  "expect": {
    "result": {
      "list": [
        {
          "a": null,
          "c": 1
        }
      ]
    }
  },
  "tags": [
    "indentation",
    "object-item"
  ]
}
