{
  "id": "core.strings.hash-escape.double-quoted.strict",
  "spec": "core",
  "section": "6.1.2",
  "description": "In strict mode `\\#` inside a double-quoted string is an unknown escape and throws, like any other unrecognised escape sequence.",
  "input": "x: \"a\\#b\"\n",
  "options": {
    "strict": true
  },
  "expect": {
    "error": {
      "line": 1,
      "code": "INVALID_ESCAPE"
    }
  },
  "tags": [
    "strict",
    "error",
    "strings",
    "escapes"
  ]
}
