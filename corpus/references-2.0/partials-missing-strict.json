{
  "id": "references-2.partials.missing.strict",
  "spec": "references",
  "section": "3.1",
  "description": "A partial key not found in the validated partials map throws in strict mode after reference resolution.",
  "input": "a: $(:missing)\n",
  "options": {
    "strict": true,
    "partials": {}
  },
  "expect": {
    "error": {
      "line": 1,
      "token": "$(:missing)",
      "code": "UNRESOLVED_REFERENCE"
    }
  },
  "tags": [
    "strict",
    "error",
    "partial"
  ],
  "specVersion": "2.0"
}
