{
  "id": "references-2.syntax.namespace-colon.disambiguation",
  "spec": "references",
  "specVersion": "2.0",
  "section": "2.3",
  "description": "The delimiters select the document or partial namespace; a colon within either path remains part of the document key or partial name.",
  "input": "\"a:b\": document\ndocumentResult: ${a:b}\npartialResult: $(a:b)\n",
  "options": { "partials": { "a:b": "partial" } },
  "expect": {
    "result": {
      "a:b": "document",
      "documentResult": "document",
      "partialResult": "partial"
    }
  },
  "tags": ["positive", "syntax", "namespace"]
}
