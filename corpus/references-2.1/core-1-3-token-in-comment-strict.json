{
  "id": "references-2.core-1-3.token-in-comment.strict",
  "spec": "references",
  "specVersion": "2.1",
  "section": "2.4",
  "description": "References 2.1 under Core 1.3: a token in a comment is no token; the value is null (Core §4). Strict mode.",
  "input": "a: 42\nb: #${a}\n",
  "options": {
    "strict": true
  },
  "expect": {
    "result": {
      "a": 42,
      "b": null
    }
