{
  "name": "@limaformat/lima-language-server",
  "version": "0.1.0",
  "description": "Language Server Protocol diagnostics for Lima",
  "keywords": ["lima", "language-server", "lsp", "frontmatter", "markdown"],
  "homepage": "https://limaformat.dev",
  "author": "Michael Kortstiege",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limaformat/lima.git",
    "directory": "editors/lsp"
  },
  "bugs": "https://github.com/limaformat/lima/issues",
  "license": "ISC",
  "type": "module",
  "bin": {
    "lima-language-server": "dist/server.js"
  },
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "bun build --target=node --format=esm --outfile=dist/server.js --banner='#!/usr/bin/env node' src/server.ts",
    "prepack": "bun run build",
    "prepublishOnly": "bunx tsc --noEmit && bun test && bun run build",
    "test": "bun test"
  },
  "dependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
