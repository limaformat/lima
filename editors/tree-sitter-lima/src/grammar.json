              },
              {
                "type": "PATTERN",
                "value": "[^\"\\\\\\r\\n]+"
              },
              {
                "type": "PATTERN",
                "value": "\\\\[^\"\\r\\n]?"
              }
            ]
          }
        },
        {
          "type": "STRING",
