      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "'"
        },
        {
          "type": "PATTERN",
          "value": "[^'\\r\\n]*"
        },
        {
          "type": "STRING",
          "value": "'"
        }
      ]
    },
    "double_quoted_key": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
