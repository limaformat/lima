      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[\\p{L}\\p{N}_][\\p{L}\\p{M}\\p{N}_*·-]*(?::[\\p{L}\\p{N}_][\\p{L}\\p{M}\\p{N}_*·-]*)*",
