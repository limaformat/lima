{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "lima",
      "camelcase": "Lima",
      "title": "Lima",
      "scope": "source.lima",
      "file-types": [
        "lima"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^lima$",
      "class-name": "TreeSitterLima"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "ISC",
    "description": "Tree-sitter grammar for Lima (Core 1.0 + active References 2.0 tokens)",
    "authors": [
      {
        "name": "Lima contributors"
      }
    ],
    "links": {
      "repository": "https://github.com/limaformat/lima"
    }
  }
}
